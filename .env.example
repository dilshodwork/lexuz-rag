# Nusxa oling:  cp .env.example .env   va kalitni o'zingiz yozing (chatga yubormang)
LLM_PROVIDER=gemini          # gemini | openai | anthropic
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=                   # bo'sh: gemini-3.1-flash-lite / gpt-4.1-mini / claude-sonnet-4-5

# Bepul sinov (server kaliti bilan, o'z AI kaliti ulanmagan foydalanuvchilar uchun)
FREE_DAILY_LIMIT=5           # bitta foydalanuvchiga kuniga savol
GLOBAL_DAILY_LIMIT=100       # hammaga birgalikda kuniga savol (0 = bepul rejim o'chiq)
TELEGRAM_BOT_TOKEN=          # ixtiyoriy: Mini App foydalanuvchisi initData imzosi bilan aniqlanadi
