# Nusxa oling:  cp .env.example .env   va kalitni o'zingiz yozing (chatga yubormang)
LLM_PROVIDER=gemini          # gemini | openai | anthropic
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=                   # bo'sh: gemini-3.1-flash-lite / gpt-4.1-mini / claude-sonnet-4-5

# Bepul sinov (server kaliti bilan, o'z AI kaliti ulanmagan foydalanuvchilar uchun)
FREE_DAILY_LIMIT=5           # bitta foydalanuvchiga kuniga savol
GLOBAL_DAILY_LIMIT=100       # hammaga birgalikda kuniga savol (0 = bepul rejim o'chiq)
TELEGRAM_BOT_TOKEN=          # ixtiyoriy: Mini App foydalanuvchisi initData imzosi bilan aniqlanadi

# Internetga chiqarish (Hugging Face Spaces'da Settings -> Variables and secrets; hf_deploy.py o'zi qo'yadi)
# ENV=production             # /api/docs o'chiq, HSTS, eval/run faqat EVAL_TOKEN bilan, xato tafsiloti yashirin
# EVAL_TOKEN=                # /baholash "Qayta hisoblash" ruxsat kaliti (production'da bo'lmasa - o'chiq)
# RATE_LIMIT_PER_MIN=20      # qidiruv/savol/proksi: bitta qurilmaga daqiqasiga
# RATE_LIMIT_PER_DAY=400     # bitta qurilmaga kuniga
# RATE_IP_FACTOR=3           # IP limiti = qurilma limiti x shu son
# TRUST_PROXY=1              # proksi ortida (HF Spaces): IP X-Forwarded-For dan (Dockerfile'da yoqilgan)
# OPENAI_MODELS=             # OpenAI proksisi ruxsat bergan modellar (vergul bilan), bo'sh - standart ro'yxat
# ALLOWED_ORIGINS=           # boshqa domendan POST ruxsati (vergul bilan), odatda kerak emas
# HF_DATASET=<user>/dalil-index   # konteyner start'da indeks shu dataset'dan yuklanadi
# DALIL_DATA_DIR=            # ma'lumotlar papkasi (konteynerda /data/dalil yoki /tmp/dalil)
